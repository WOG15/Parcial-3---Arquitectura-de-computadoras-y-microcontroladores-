###################################################################

# Created by write_sdc on Sun Oct 25 15:45:10 2026

###################################################################
set sdc_version 2.2

set_units -time ns -resistance kOhm -capacitance pF -voltage V -current mA
create_clock [get_ports clk]  -period 35  -waveform {0 17.5}
set_clock_uncertainty 0.5  [get_clocks clk]
set_input_delay -clock clk  2  [get_ports reset]
set_input_delay -clock clk  2  [get_ports {A[15]}]
set_input_delay -clock clk  2  [get_ports {A[14]}]
