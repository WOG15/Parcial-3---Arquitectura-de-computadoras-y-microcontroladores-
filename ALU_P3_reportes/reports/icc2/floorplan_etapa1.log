# ============================================================================
# ICC2 / ALU+ M31: floorplan inicial (etapa 1, sin PG ni routing)
# Uso: desde ~/parcial_3:
#   icc2_shell -f scripts/icc2/floorplan_alu_m31_etapa1.tcl \
#     |& tee reports/icc2/floorplan_etapa1.log
#
# Presupone que initial_alu_m31.tcl se ejecuto y guardo el bloque alu_imported.
# NO volver a ejecutar setup_alu_m31.tcl ni initial_alu_m31.tcl.
# NO configura capa/track de SKY130, TLUPlus, UPF, taps, VDD/VSS ni power grid.
# ============================================================================
set PROJECT_ROOT [file normalize [pwd]]
/home/worellana/parcial_3
set DESIGN_LIB [file join $PROJECT_ROOT outputs icc2 alu_import_35ns alu_m31.nlib]
/home/worellana/parcial_3/outputs/icc2/alu_import_35ns/alu_m31.nlib
set REPORT_DIR [file join $PROJECT_ROOT reports icc2 floorplan_etapa1]
/home/worellana/parcial_3/reports/icc2/floorplan_etapa1
set INPUT_BLOCK alu_imported
alu_imported
set OUTPUT_BLOCK alu_floorplan_etapa1
alu_floorplan_etapa1
if {![file exists $DESIGN_LIB]} {
    error "No se encuentra la biblioteca de ICC2: $DESIGN_LIB"
}
file mkdir $REPORT_DIR
# Recuperar el trabajo guardado en la importacion.
open_lib $DESIGN_LIB
Information: Loading library file '/home/worellana/parcial_3/outputs/icc2/alu_import_35ns/alu_m31.nlib' (FILE-007)
Information: Loading library file '/home/worellana/parcial_3/technology/m31/ndm/m31_3m1t_11k.ndm' (FILE-007)
{alu_m31.nlib}
open_block $INPUT_BLOCK
Information: User units loaded from library 'm31_3m1t_11k' (LNK-040)
Opening block 'alu_m31.nlib:alu_imported.design' in edit mode
{alu_m31.nlib:alu_imported.design}
set CLK [get_clocks clk -quiet]
Using libraries: alu_m31.nlib m31_3m1t_11k
Visiting block alu_m31.nlib:alu_imported.design
Design 'alu_sync_top' was successfully linked.
{clk}
if {[sizeof_collection $CLK] == 0} {
    error "El bloque importado no contiene el reloj clk; verifica alu_imported y SDC"
}
set UNBOUND [get_cells -hierarchical -filter "is_unbound == true" -quiet]
if {[sizeof_collection $UNBOUND] > 0} {
    error "Hay [sizeof_collection $UNBOUND] instancias sin vincular; abortando floorplan"
}
# Dejar constancia de la tecnologia y el reloj, para no asumir nombres de capa.
redirect -file [file join $REPORT_DIR capas_disponibles.rpt] {
    puts "Capas reportadas por la biblioteca M31:"
    puts [get_object_name [get_layers *]]
}
redirect -file [file join $REPORT_DIR clocks.rpt] {
    report_clocks
}
redirect -file [file join $REPORT_DIR netlist_check.rpt] {
    check_netlist
}
# Geometria inicial: conservadora y rectangular (no es un floorplan final).
# La herramienta ajusta el contorno segun area de celdas y sitios fisicos.
initialize_floorplan \
    -core_utilization 0.55 \
    -shape R \
    -orientation N \
    -side_ratio {1 1} \
    -core_offset {6}
