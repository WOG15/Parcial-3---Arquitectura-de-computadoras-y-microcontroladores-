redirect -file [file join $RPT clock_cells_cts.rpt] {
    puts "Buffers e inversores habilitados para CTS; atributos efectivos:"
    foreach_in_collection libcell $CTS_BUFS {
        puts "LIBCELL: [get_object_name $libcell]"
        foreach attr {dont_use included_purposes excluded_purposes valid_purposes} {
            if {[catch {get_attribute $libcell $attr} val]} {
                puts "  $attr: NO_DISPONIBLE ($val)"
            } else {
                puts "  $attr: $val"
            }
        }
    }
    foreach_in_collection libcell $CTS_INVS {
        puts "LIBCELL: [get_object_name $libcell]"
        foreach attr {dont_use included_purposes excluded_purposes valid_purposes} {
            if {[catch {get_attribute $libcell $attr} val]} {
                puts "  $attr: NO_DISPONIBLE ($val)"
            } else {
                puts "  $attr: $val"
            }
        }
    }
}
