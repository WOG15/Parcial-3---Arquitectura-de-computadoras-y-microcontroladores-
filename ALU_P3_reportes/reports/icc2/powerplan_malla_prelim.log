# 1) Malla bidireccional. METAL2 conecta rieles METAL1; METAL3
#    une las tiras METAL2. Anchuras superiores al minimo de la libreria,
#    con espaciamientos y pitch de prueba (ICC2 verificara DRC).
create_pg_mesh_pattern alu_m31_mesh_pat \
    -layers { \
        {{vertical_layer: METAL2} \
         {width: 0.48} {spacing: interleaving} \
         {pitch: 12.0} {offset: 1.44} {trim: true}} \
        {{horizontal_layer: METAL3} \
         {width: 0.90} {spacing: interleaving} \
         {pitch: 18.0} {offset: 2.70} {trim: true}} \
    } \
    -via_rule { \
        {{layers: METAL2} {layers: METAL3} {via_master: default}} \
    }
Successfully create mesh pattern alu_m31_mesh_pat.
1
set_pg_strategy alu_m31_mesh_strategy \
    -core \
    -pattern {{pattern: alu_m31_mesh_pat} {nets: {VCCK GNDK}}}
Successfully set PG strategy alu_m31_mesh_strategy.
# 2) Intentar conectar la malla y las estructuras PG existentes.
#    Algunas versiones/tecnologias exigen reglas de vias mas especificas.
set_pg_strategy_via_rule alu_m31_mesh_via_rule \
    -via_rule {{intersection: all}{via_master: default}}
Successfully set strategy via rule alu_m31_mesh_via_rule.
compile_pg -strategies {alu_m31_mesh_strategy} \
    -via_rule {alu_m31_mesh_via_rule}
