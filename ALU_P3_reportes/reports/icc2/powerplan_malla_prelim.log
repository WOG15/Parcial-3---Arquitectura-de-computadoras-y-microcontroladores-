# 4) Guardar reportes de VERIFICACION. Requieren inspeccion humana:
#    un comando que termina no prueba conectividad ni ausencia de DRC.
redirect -file [file join $RPT pg_drc.rpt] {
    check_pg_drc -nets {VCCK GNDK}
}
redirect -file [file join $RPT pg_connectivity.rpt] {
    check_pg_connectivity
}
redirect -file [file join $RPT pg_missing_vias.rpt] {
    check_pg_missing_vias
}
redirect -file [file join $RPT legality.rpt] {
    check_legality
}
