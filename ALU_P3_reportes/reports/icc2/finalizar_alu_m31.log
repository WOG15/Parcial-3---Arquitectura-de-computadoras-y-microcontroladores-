# Utilidad para conservar reportes de cada etapa sin interrumpir por reportes opcionales.
proc guardar_reportes {directorio etapa} {
    file mkdir $directorio
    foreach {nombre script} {
        qor.rpt {report_qor}
        setup.rpt {report_timing -delay_type max -max_paths 10}
        hold.rpt {report_timing -delay_type min -max_paths 10}
        legality.rpt {check_legality}
        pg_connectivity.rpt {check_pg_connectivity -nets {VCCK GNDK}}
        pg_drc.rpt {check_pg_drc -nets {VCCK GNDK}}
        routes.rpt {check_routes}
    } {
        if {[catch {redirect -file [file join $directorio $nombre] $script} err]} {
            puts "AVISO $etapa: reporte $nombre: $err"
        }
    }
}
